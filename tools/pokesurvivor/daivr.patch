+/* ============ talk.js — chat y avisos (pings) del grupo (daivr.dev) ============
+ * Chat: Intro en la partida (Intro manda, Esc cierra) y una caja en la sala.
+ * Los últimos mensajes salen abajo a la izquierda y se apagan; además, un
+ * bocadillo encima del Pokémon de quien escribe.
+ *
+ * Avisos: mantén G (o la rueda del ratón pulsada) y aparece la rueda:
+ * ¡Ayuda! (arriba), Jefe (derecha), Cofre (abajo), Aquí (izquierda). Señala
+ * con el ratón y suelta; un toque rápido avisa "Aquí" donde apuntas. Duran
+ * 6 s: una marca en el suelo o, si no se ve, una flecha en el borde.
+ *
+ * Va por la conexión de la sala (net.js): el invitado se lo manda al
+ * anfitrión y el anfitrión lo reparte a los demás (con `o`, quién lo dijo).
+ * Nada se guarda. Ajustes → Pantalla → Chat del grupo lo esconde.
+ *   { k:'say', t: texto }      { k:'ping', p: clase, x, y }
+ */
+G.Talk = (() => {
+  const P = 2, INK = '#1b1528';
+  const MAX = 120, LOG_N = 6, LOG_T = 12, BUBBLE_T = 4.5, PING_T = 6, GAP_MS = 700;
+  const PINGS = {
+    help:  { icon: 'ping-help', col: '#ff5f6d', text: '¡Ayuda!', sfx: 'error' },
+    boss:  { icon: 'ping-boss', col: '#c47bff', text: '¡Jefe!', sfx: 'surge' },
+    chest: { icon: 'ping-chest', col: '#ffd23f', text: 'Cofre', sfx: 'coin' },
+    here:  { icon: 'ping-here', col: '#4fb4ff', text: 'Aquí', sfx: 'select' }
+  };
+  // Rueda: hacia dónde queda cada clase (ángulo en radianes, 0 = derecha).
+  const WHEEL = [['help', -Math.PI / 2], ['boss', 0], ['chest', Math.PI / 2], ['here', Math.PI]];
+  const WR = 92;
+
+  let log = [], bubbles = new Map(), pings = [];
+  let lastSent = 0, input = null, wheel = null;
+  const F = (w, s) => `${w} ${s}px Pixelify,"Segoe UI",system-ui,sans-serif`;
+  const snap = v => Math.round(v / P) * P;
+
+  // ---------------- quién es quién ----------------
+
+  const myUid = () => G.Social.uid;
+  function members() { return (G.Social.room && G.Social.room.members) || []; }
