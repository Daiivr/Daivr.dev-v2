new file mode 100644
index 0000000..1544478
--- /dev/null
+++ b/js/ui/stats-ui.js
@@ -0,0 +1,401 @@
+/* ============ stats-ui.js — estadísticas, partidas y tarjeta para compartir (daivr.dev) ============
+ * Durante la partida se apunta el daño total de cada jugador cada 5 s
+ * (track / sample / finish, desde game.js). Al acabar se guarda un resumen en
+ * este navegador (las últimas 30 partidas) y, en partidas normales, los
+ * récords de ese Pokémon en la partida guardada (save.precs, ver db.js).
+ *
+ * Pantalla: tus totales, la lista de partidas y, al elegir una, sus números,
+ * la gráfica de daño por segundo (una línea por jugador), sus mejores
+ * ataques, el reparto del daño del grupo y una tarjeta para compartir
+ * (imagen para copiar o guardar).
+ */
+G.StatsUI = (() => {
+  const KEY = 'ps.daivr.runs.v1', NEW_KEY = 'ps.daivr.runs.new', MAX_RUNS = 30, STEP = 5, MAX_POINTS = 90;
+  const $ = id => document.getElementById(id);
+  const F = (w, s) => `${w} ${s}px Pixelify,"Segoe UI",system-ui,sans-serif`;
+  const esc = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
+  const ME = 'me';
+
+  // ---------------- guardar ----------------
+
+  function load() {
+    try { const l = JSON.parse(localStorage.getItem(KEY) || '[]'); return Array.isArray(l) ? l.filter(r => r && r.v === 1) : []; }
+    catch (e) { return []; }
+  }
+  function store(list) {
+    try { localStorage.setItem(KEY, JSON.stringify(list.slice(0, MAX_RUNS))); } catch (e) { /* lleno o bloqueado */ }
+  }
+
+  // ---------------- apuntar la partida ----------------
+
+  let rec = null;
+  /** Al empezar la partida. */
+  function track() { rec = { next: STEP, t: [], p: new Map() }; }
+  function who(p) { return p === G.Game.player ? ME : p.uid || ME; }
+  /** Cada fotograma de juego (game.js): cada 5 s, el daño total de cada uno. */
+  function sample(time, players) {
+    if (!rec || time < rec.next) return;
+    rec.next += STEP;
+    put(time, players);
+  }
+  function put(time, players) {
+    rec.t.push(Math.round(time));
+    for (const p of players) {
+      const k = who(p);
