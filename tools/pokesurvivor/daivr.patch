index 0000000..885c272
--- /dev/null
+++ b/js/net/daivr.js
@@ -0,0 +1,143 @@
+/* ============ daivr.js — conexión con daivr.dev ============
+ * En daivr.dev el juego no usa Firebase: la cuenta es la sesión de Discord de
+ * la web y todo lo online va a su API (server/pokesurvivor.mjs en daivr.dev):
+ *
+ *   api(ruta, cuerpo)   peticiones a /api/pokesurvivor/... (con la cookie de sesión)
+ *   connect()           un stream SSE por jugador con amigos, invitaciones, la
+ *                       sala, la lista de partidas abiertas y los mensajes del
+ *                       relé (los eventos llegan por on())
+ *   relay(para, msg)    mensajes para otro jugador de tu sala (se agrupan)
+ *   discordLogin()      ventana emergente de Discord; avisa al acabar
+ */
+G.Daivr = (() => {
+  const BASE = '/api/pokesurvivor/';
+  // Dentro de la tele de la web, el volumen y la pantalla completa son los
+  // del propio aparato: los botones del juego se esconden (css/style.css).
+  if (window.parent !== window) document.documentElement.classList.add('in-daivr-tv');
+  const EVENTS = ['hello', 'friends', 'invites', 'room', 'rooms', 'relay', 'replaced'];
+  const handlers = new Map();
+  // Lo que se manda al cerrar (salir de la sala, el último mensaje del relé):
+  // al apagar la tele se quita el iframe y sus peticiones se cancelan aunque
+  // lleven keepalive, así que van con el fetch de la web, que sigue abierta.
+  let lastFetch = fetch.bind(window);
+  try { if (window.parent !== window && window.parent.fetch) lastFetch = window.parent.fetch.bind(window.parent); } catch (e) { /* otro origen */ }
+
+  function on(name, fn) { if (!handlers.has(name)) handlers.set(name, new Set()); handlers.get(name).add(fn); }
+  function off(name, fn) { const s = handlers.get(name); if (s) s.delete(fn); }
+  function emit(name, data) {
+    const s = handlers.get(name);
+    if (s) s.forEach(fn => { try { fn(data); } catch (e) { console.warn('[Daivr]', name, e); } });
+  }
+
+  /**
+   * Petición a la API. Sin cuerpo es un GET; con cuerpo, un POST en JSON.
+   * Los errores llevan code (el de la API: 'taken', 'room-full'...) y status.
+   */
+  async function api(path, body, opts = {}) {
+    const init = { credentials: 'same-origin', cache: 'no-store', headers: { Accept: 'application/json' } };
+    if (opts.method) init.method = opts.method;
+    if (body !== undefined) {
+      init.method = init.method || 'POST';
+      init.headers['Content-Type'] = 'application/json';
+      init.body = JSON.stringify(body);
+    }
+    if (opts.keepalive) init.keepalive = true;
+    let ctrl = null, t = 0;
+    if (opts.timeout && window.AbortController) { ctrl = new AbortController(); init.signal = ctrl.signal; t = setTimeout(() => ctrl.abort(), opts.timeout); }
+    try {
+      const r = await (opts.keepalive ? lastFetch : fetch)(BASE + path, init);
+      let j = null;
+      try { j = await r.json(); } catch (e) { /* sin cuerpo */ }
+      if (!r.ok) throw Object.assign(new Error((j && j.error) || 'HTTP ' + r.status), { code: (j && j.code) || String(r.status), status: r.status });
+      return j || {};
+    } catch (e) {
+      if (e && e.name === 'AbortError') throw Object.assign(new Error('timeout'), { code: 'unavailable', status: 0 });
+      if (e && e.status === undefined) e.code = e.code || 'unavailable';
+      throw e;
+    } finally { clearTimeout(t); }
+  }
+
+  // ---------------- stream ----------------
+
+  let es = null;
+  function connect() {
+    if (es || !window.EventSource) return;
+    es = new EventSource(BASE + 'stream');
+    for (const name of EVENTS) {
+      es.addEventListener(name, e => {
+        let d = null;
+        try { d = JSON.parse(e.data); } catch (err) { return; }
+        // Otra pestaña ha abierto el juego con tu cuenta: ésta deja de recibir.
+        if (name === 'replaced') disconnect();
+        emit(name, d);
+      });
+    }
+    es.onerror = () => {
+      // Sesión caducada o servidor reiniciando: el navegador reintenta solo
+      // salvo que la respuesta no sea un stream (entonces se cierra).
+      if (es && es.readyState === 2) { es = null; emit('down', null); }
+    };
+  }
+  function disconnect() { if (es) { es.close(); es = null; } }
+
+  // ---------------- relé ----------------
+  // Los mensajes de un mismo fotograma (candidatos ICE, eventos) van juntos en
+  // una sola petición.
+  const outbox = new Map();
+  let flushT = 0;
+  function relay(to, env) {
+    if (!outbox.has(to)) outbox.set(to, []);
+    outbox.get(to).push(env);
+    if (!flushT) flushT = setTimeout(() => flushRelay(), 0);
+  }
+  /** Envía lo que haya en cola (keepalive: al cerrar la página, para que llegue igual). */
+  function flushRelay(keepalive = false) {
+    clearTimeout(flushT);
+    flushT = 0;
+    for (const [to, items] of outbox) {
+      outbox.delete(to);
+      api('relay', { to, items }, { keepalive }).catch(e => console.warn('[Daivr] relé:', e.code || e.message));
+    }
+  }
+
+  // ---------------- login con Discord ----------------
+  // El login de la web acaba en pokesurvivor/discord-done.html, que avisa por
+  // BroadcastChannel (y localStorage, por si acaso) y se cierra. Discord corta
+  // la relación con la ventana (COOP), así que no se mira window.closed.
+  const LOGIN_URL = '/api/comments/auth/discord?return=' + encodeURIComponent('/pokesurvivor/discord-done.html');
+  let waiting = null;
+  function discordLogin() {
+    const w = window.open(LOGIN_URL, 'daivr-discord', 'popup,width=520,height=780');
