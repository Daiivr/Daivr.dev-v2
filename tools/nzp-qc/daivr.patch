+// daivr.dev: report this player's game to the page around the game
+// (public/nzp/shell.js reads it from the engine's console output):
+// "[daivr] nzp-stats <phase> <round> <kills> <total score> <map>".
+void(string phase) Daivr_ReportStats =
+{
+	entity me = findfloat(world, playernum, getplayerkeyfloat(player_localnum, "client_index"));
+	print(sprintf("[daivr] nzp-stats %s %d %d %d %s\n", phase, rounds, me.kills, getstatf(STAT_TOTALSCORE), mapname));
+};
