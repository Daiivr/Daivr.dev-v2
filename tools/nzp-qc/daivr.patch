+//
+// daivr.dev: Menu_DrawRankNote(note)
+// A pulsing, glowing line under the hovered button's description (which
+// Menu_Button draws 30 units above the bottom of the frame). Used for the
+// Game Settings that keep a game out of the rankings.
+//
+void(string note) Menu_DrawRankNote =
+{
+	float pulse = 0.5 + 0.5 * fabs(sin(time * 3));
+	vector glow = [1, 0.35, 0];
+
+	sui_set_align([SUI_ALIGN_CENTER, SUI_ALIGN_END]);
+
+	// Halo: the text added around itself in orange, in rings that fade out
+	// (drawflag 1 = additive), breathing with the pulse.
+	for (float ring = 1; ring <= 3; ring++) {
+		float ring_alpha = (0.7 / ring) * pulse;
+		sui_text([-ring, -12], MENU_TEXT_SMALL, note, glow, ring_alpha, 1);
+		sui_text([ring, -12], MENU_TEXT_SMALL, note, glow, ring_alpha, 1);
+		sui_text([0, -12 - ring], MENU_TEXT_SMALL, note, glow, ring_alpha, 1);
+		sui_text([0, -12 + ring], MENU_TEXT_SMALL, note, glow, ring_alpha, 1);
+		sui_text([-ring, -12 - ring], MENU_TEXT_SMALL, note, glow, ring_alpha * 0.5, 1);
+		sui_text([ring, -12 + ring], MENU_TEXT_SMALL, note, glow, ring_alpha * 0.5, 1);
+		sui_text([ring, -12 - ring], MENU_TEXT_SMALL, note, glow, ring_alpha * 0.5, 1);
+		sui_text([-ring, -12 + ring], MENU_TEXT_SMALL, note, glow, ring_alpha * 0.5, 1);
+	}
+
+	sui_text([0, -12], MENU_TEXT_SMALL, note, [1, 0.9, 0.45], 1, 0);
+
+	sui_set_align([SUI_ALIGN_START, SUI_ALIGN_START]);
+};
