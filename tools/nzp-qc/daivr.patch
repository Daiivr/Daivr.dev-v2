+void(entity who) Player_DrawWeapon =
+{
+	if (!who.daivr_weapon || who.is_spectator)
+		return;
+
+	string weapon_model = GetWeaponModel(who.daivr_weapon, 1);
+	if (weapon_model == "")
+		return;
+
+	entity weapon_ent = who.daivr_weapon_ent;
+	if (!weapon_ent) {
+		weapon_ent = spawn();
+		who.daivr_weapon_ent = weapon_ent;
+	}
+
+	if (weapon_ent.model != weapon_model) {
+		precache_model(weapon_model);
+		setmodel(weapon_ent, weapon_model);
+	}
+
+	// Blend the two frames the model is blending (Player_PreDraw's lerpfrac).
+	vector hand = Player_HandPosition(who.frame) * (1 - who.lerpfrac) + Player_HandPosition(who.frame2) * who.lerpfrac;
+	// The weapon models' grips sit about 2 units under their origin.
+	hand_z += 2;
+
+	// Turn it the way the model turns: Quake models pitch the opposite way
+	// to makevectors (r_meshpitch -1).
+	makevectors([-who.angles_x, who.angles_y, who.angles_z]);
+	setorigin(weapon_ent, who.origin + v_forward * hand_x - v_right * hand_y + v_up * hand_z);
+	weapon_ent.angles = who.angles;
+	weapon_ent.renderflags = (who.entnum == player_localentnum) ? RF_EXTERNALMODEL : 0;
+	addentity(weapon_ent);
+};
