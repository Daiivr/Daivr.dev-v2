+//
+// daivr.dev: SV_ShouldPause(newstatus)
+// The host's pause menu pauses the game for everyone (client/main.qc,
+// ToggleMenu). Only the host may, so a guest can't freeze the session.
+// The host is the listen server's own client: the first player slot.
+//
+float(float newstatus) SV_ShouldPause =
+{
+	if (self == world || player_count <= 1)
+		return true;
+
+	return self == nextent(world) || infokey(self, "ip") == "loopback";
