diff --git a/source/menu/menu_paus.qc b/source/menu/menu_paus.qc
index dbf8008..907b2a9 100644
--- a/source/menu/menu_paus.qc
+++ b/source/menu/menu_paus.qc
@@ -123,3 +123,90 @@ void() Menu_Pause =
 
 	sui_pop_frame();	
 };
+
+//
+// daivr.dev: game over choices
+// Everyone is down: GAME OVER and the scoreboard stay up (the server no
+// longer restarts on its own) and the choices fade in under the scoreboard.
+// TRY AGAIN restarts the map for everyone, so only the host gets it; guests
+// see who decides. RETURN TO MENU leaves the game.
+//
+float menu_gameover_at;
+float menu_gameover_chosen;
+
+void() Menu_GameOver_Open =
+{
+	current_menu = MENU_GAMEOVER;
+	setcursormode(TRUE, cvar_string("cl_cursor"), __NULL__, cvar("cl_cursor_scale"));
+};
+
+string(string prev_id) Menu_GameOver_GetNextButton =
+{
+	if (isserver() && prev_id != "go_retry")
+		return "go_retry";
+
+	return "go_menu";
+};
+
+string(string next_id) Menu_GameOver_GetPreviousButton =
+{
+	if (isserver() && next_id == "go_menu")
+		return "go_retry";
+
+	return "go_menu";
+};
+
+// Plain text like the menu's buttons, red when hovered. The whole row is
+// clickable. An empty id draws the text greyed out, without an action.
+float(string id, vector pos, vector size, string title, float alpha) Menu_GameOver_Button =
+{
+	float is_hovered = id != "" && !menu_gameover_chosen && sui_is_hovered(id);
+	vector text_color = [1, 1, 1];
+
+	if (id == "")
+		text_color = [0.5, 0.3, 0.3];
+	else if (is_hovered)
+		text_color = [1, 0, 0];
+
+	sui_text(pos + [(size_x - getTextWidth(title, MENU_TEXT_MEDIUM_x)) / 2, (size_y - MENU_TEXT_MEDIUM_y) / 2], MENU_TEXT_MEDIUM, title, text_color, alpha, 0);
+
+	// Only clickable once fully shown, so a click meant for the game can't land here.
+	if (id == "" || alpha < 1 || menu_gameover_chosen)
+		return FALSE;
+
+	sui_action_element(pos, size, id, sui_noop);
+	return sui_is_clicked(id);
+};
+
+void() Menu_GameOver_Retry =
+{
+	menu_gameover_chosen = TRUE;
+	Menu_PlaySound(MENU_SND_ENTER);
+	localcmd("restart\n");
+};
+
+void() Menu_GameOver_Leave =
+{
+	menu_gameover_chosen = TRUE;
+	Menu_PlaySound(MENU_SND_ENTER);
+	localcmd("disconnect\n");
+};
+
+void() Menu_GameOver =
+{
+	vector screen = sui_current_frame_size();
+	vector size = [240, 20];
+	// Just under the scoreboard (client/hud.qc HUD_Scores: rows from y 195, 15 apart, 4 at most).
+	vector pos = [screen_x / 2 - size_x / 2, 195 + bound(1, player_count, 4) * 15 + 16];
+	float alpha = bound(0, (cltime - menu_gameover_at) * 2, 1);
+
+	sui_set_align([SUI_ALIGN_START, SUI_ALIGN_START]);
+
+	if (isserver())
+		Menu_GameOver_Button("go_retry", pos, size, "TRY AGAIN", alpha) ? Menu_GameOver_Retry() : 0;
+	else
+		Menu_GameOver_Button("", pos, size, "WAITING FOR HOST", alpha);
+
+	// 25 apart, like the menu's rows.
+	Menu_GameOver_Button("go_menu", pos + [0, 25], size, "RETURN TO MENU", alpha) ? Menu_GameOver_Leave() : 0;
+};
